{
    "manifest_version": 3,
    "name": "__MSG_appName__",
    "version": "2.5.0",
    "description": "__MSG_appDesc__",
    "default_locale": "en",
    "minimum_chrome_version": "116",
    "permissions": ["storage", "activeTab", "sidePanel"],
    "host_permissions": [
        "https://*.disneyplus.com/*",
        "https://*.netflix.com/*",
        "https://*.media.dssott.com/*",
        "https://*.dssedge.com/*",
        "https://*.nflxvideo.net/*",
        "https://translate.googleapis.com/*",
        "https://api.cognitive.microsofttranslator.com/*",
        "https://edge.microsoft.com/*",
        "https://api-free.deepl.com/*",
        "https://api.deepl.com/*",
        "https://aiplatform.googleapis.com/*",
        "https://us-central1-aiplatform.googleapis.com/*",
        "https://us-east1-aiplatform.googleapis.com/*",
        "https://us-west1-aiplatform.googleapis.com/*",
        "https://europe-west1-aiplatform.googleapis.com/*",
        "https://europe-west4-aiplatform.googleapis.com/*",
        "https://asia-northeast1-aiplatform.googleapis.com/*",
        "https://asia-southeast1-aiplatform.googleapis.com/*",
        "https://oauth2.googleapis.com/*",
        "https://api.openai.com/*",
        "https://generativelanguage.googleapis.com/*"
    ],
    "optional_host_permissions": [
        "https://*/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
    ],
    "background": {
        "service_worker": "background.js",
        "type": "module"
    },
    "content_scripts": [
        {
            "matches": ["https://*.disneyplus.com/*"],
            "js": ["content_scripts/platforms/disneyPlusContent.js"],
            "css": ["content_scripts/shared/content.css"],
            "run_at": "document_start"
        },
        {
            "matches": ["https://*.netflix.com/*"],
            "js": ["content_scripts/platforms/netflixContent.js"],
            "css": ["content_scripts/shared/content.css"],
            "run_at": "document_start"
        }
    ],
    "web_accessible_resources": [
        {
            "resources": [
                "_locales/*",
                "config/configSchema.js",
                "utils/hostPermissions.js",
                "utils/cueTextNormalizer.js",
                "services/configService.js",
                "services/configServiceErrorHandler.js",
                "utils/logger.js",
                "content_scripts/shared/constants/messageActions.js",
                "content_scripts/shared/constants/injection.js",
                "content_scripts/shared/constants/providers.js",
                "content_scripts/shared/constants/contextTypes.js",
                "content_scripts/shared/injectionChannel.js",
                "injected_scripts/disneyPlusInject.js",
                "video_platforms/disneyPlusPlatform.js",
                "content_scripts/shared/subtitleUtilities.js",
                "content_scripts/shared/subtitleParsing.js",
                "content_scripts/shared/messaging.js",
                "content_scripts/shared/protocol/messageProtocol.js",
                "content_scripts/shared/protocol/plainDataSnapshot.js",
                "content_scripts/shared/subtitleRequestIdentity.js",
                "content_scripts/shared/navigationUtils.js",
                "content_scripts/shared/interactiveSubtitleFormatter.js",
                "video_platforms/BasePlatformAdapter.js",
                "utils/cache/TTLCache.js",
                "content_scripts/aicontext/core/AIContextManager.js",
                "content_scripts/aicontext/core/PrivateAnalysisController.js",
                "content_scripts/aicontext/core/AIContextChannel.js",
                "content_scripts/aicontext/core/constants.js",
                "content_scripts/aicontext/ui/modal.js",
                "content_scripts/aicontext/ui/modal.css",
                "content_scripts/aicontext/ui/modal-core.js",
                "content_scripts/aicontext/ui/modal-ui.js",
                "content_scripts/aicontext/ui/modal-events.js",
                "content_scripts/aicontext/ui/modal-animations.js",
                "content_scripts/aicontext/ui/animations/Transitions.js",
                "content_scripts/aicontext/core/state/SelectionModel.js",
                "content_scripts/aicontext/core/state/ModalStore.js",
                "content_scripts/aicontext/ui/events/ModalController.js",
                "content_scripts/aicontext/providers/AIContextProvider.js",
                "content_scripts/aicontext/utils/selectionPersistence.js",
                "content_scripts/core/BaseContentScript.js",
                "content_scripts/core/aiContextLifecycle.js",
                "content_scripts/core/contentSelectionAuthority.js",
                "content_scripts/core/sidePanelWordRouter.js",
                "content_scripts/core/utils.js",
                "content_scripts/core/constants.js",
                "content_scripts/platforms/DisneyPlusContentScript.js",
                "utils/languageNormalization.js",
                "injected_scripts/netflixInject.js",
                "video_platforms/netflixPlatform.js",
                "content_scripts/platforms/NetflixContentScript.js"
            ],
            "matches": ["https://*.disneyplus.com/*", "https://*.netflix.com/*"]
        }
    ],
    "action": {
        "default_popup": "popup/popup.html",
        "default_icon": {
            "16": "icons/icon16.png",
            "48": "icons/icon48.png",
            "128": "icons/icon128.png"
        }
    },
    "options_ui": {
        "page": "options/options.html",
        "open_in_tab": true
    },
    "icons": {
        "16": "icons/icon16.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    },
    "side_panel": {
        "default_path": "sidepanel/sidepanel.html"
    }
}
