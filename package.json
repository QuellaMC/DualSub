{
    "name": "dualsub",
    "version": "2.5.0",
    "private": true,
    "packageManager": "npm@11.6.2",
    "engines": {
        "node": ">=24",
        "npm": ">=11"
    },
    "type": "module",
    "description": "Displays dual language subtitles on streaming platforms.",
    "main": "background.js",
    "scripts": {
        "format": "prettier --write --ignore-unknown .",
        "format:check": "prettier --check --ignore-unknown .",
        "lint": "eslint . --max-warnings=0",
        "lint:fix": "eslint . --fix --max-warnings=0",
        "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
        "test:ci": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand",
        "test:coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage --runInBand",
        "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
        "build": "vite build",
        "verify:build": "node scripts/verify-extension-build.mjs",
        "dev": "vite build --watch",
        "preview": "vite preview"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/QuellaMC/DualSub.git"
    },
    "keywords": [
        "chrome-extension",
        "subtitles",
        "netflix",
        "disneyplus"
    ],
    "author": "QuellaMC",
    "license": "CC-BY-NC-SA-4.0",
    "bugs": {
        "url": "https://github.com/QuellaMC/DualSub/issues"
    },
    "homepage": "https://github.com/QuellaMC/DualSub#readme",
    "devDependencies": {
        "@babel/core": "^8.0.1",
        "@babel/preset-react": "^8.0.1",
        "@eslint/js": "^10.0.1",
        "@testing-library/jest-dom": "^7.0.0",
        "@testing-library/react": "^16.3.2",
        "@testing-library/user-event": "^14.6.1",
        "@vitejs/plugin-react": "^6.0.4",
        "babel-jest": "^30.4.1",
        "eslint": "^10.8.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^7.1.1",
        "globals": "^17.7.0",
        "jest": "^30.4.2",
        "jest-environment-jsdom": "^30.4.1",
        "prettier": "^3.9.6",
        "vite": "^8.1.5"
    },
    "dependencies": {
        "react": "^19.2.7",
        "react-dom": "^19.2.7"
    }
}
