{
    "name": "dualsub",
    "version": "3.0.2",
    "private": true,
    "packageManager": "npm@11.6.2",
    "engines": {
        "node": ">=24",
        "npm": ">=11"
    },
    "type": "module",
    "description": "Displays dual language subtitles on streaming platforms.",
    "scripts": {
        "postinstall": "wxt prepare",
        "dev": "wxt",
        "build": "wxt build",
        "zip": "wxt zip",
        "verify:release": "node scripts/verify-release.mjs",
        "compile": "tsc --noEmit",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "format": "prettier --write --ignore-unknown .",
        "format:check": "prettier --check --ignore-unknown .",
        "lint": "eslint . --max-warnings=0",
        "lint:fix": "eslint . --fix --max-warnings=0"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/QuellaMC/DualSub.git"
    },
    "keywords": [
        "chrome-extension",
        "subtitles",
        "netflix",
        "disneyplus"
    ],
    "author": "QuellaMC",
    "license": "CC-BY-NC-SA-4.0",
    "bugs": {
        "url": "https://github.com/QuellaMC/DualSub/issues"
    },
    "homepage": "https://github.com/QuellaMC/DualSub#readme",
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/react": "^16.3.3",
        "@types/react": "^19.2.18",
        "@types/react-dom": "^19.2.5",
        "@vitest/coverage-v8": "^4.1.11",
        "@wxt-dev/module-react": "^1.2.2",
        "eslint": "^10.9.1",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^7.1.1",
        "globals": "^17.12.0",
        "happy-dom": "^20.13.0",
        "prettier": "^3.9.6",
        "typescript": "^7.0.2",
        "typescript-eslint": "^8.69.0",
        "vite": "^8.2.2",
        "vitest": "^4.1.11",
        "wxt": "^0.21.4"
    },
    "dependencies": {
        "react": "^19.2.7",
        "react-dom": "^19.2.7",
        "zod": "^4.5.4"
    }
}
